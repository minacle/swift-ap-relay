<!DOCTYPE html>
<html lang="#(locale)">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    #if(hasDescription):
    <meta name="description" content="#(ogDescription)">
    #endif
    <meta property="og:type" content="website">
    <meta property="og:title" content="#(relayName)">
    <meta property="og:site_name" content="#(relayName)">
    <meta property="og:url" content="#(relayURL)">
    #if(hasDescription):
    <meta property="og:description" content="#(ogDescription)">
    #endif
    <meta name="twitter:card" content="summary">
    <title>#(relayName)</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>#(relayName)</h1>
        <div class="header-meta">
            #if(isRestrictedMode):
            <span class="badge badge-restricted">#(t_statusRestricted)</span>
            #else:
            <span class="badge badge-open">#(t_statusOpen)</span>
            #endif
            #if(isManualAccept):
            <span class="badge badge-muted">#(t_statusManualAccept)</span>
            #else:
            <span class="badge badge-muted">#(t_statusAutoAccept)</span>
            #endif
        </div>
    </header>

    <main>
        #if(hasDescription):
        <div class="description">#unsafeHTML(description)</div>
        #endif

        #if(isRestrictedMode):
        <div class="notice notice-restricted">
            #(t_restrictedNotice)
        </div>
        #endif

        #if(isManualAccept):
        <div class="notice notice-restricted">
            #(t_manualAcceptNotice)
        </div>
        #endif

        <section class="card">
            <h2>#(t_howToSubscribe)</h2>

            <h3>#(t_mastodonMisskey)</h3>
            <p>#(t_mastodonMisskeyDesc)</p>
            <code class="relay-url">#(inboxURL)</code>

            <h3>#(t_pleromaAkkoma)</h3>
            <p>#(t_pleromaAkkomaDesc)</p>
            <code class="relay-url">#(actorURL)</code>

            <h3>#(t_others)</h3>
            <p>#(t_othersDesc)</p>
        </section>

        <section class="card">
            <h2>#(t_connectedInstances) (#(subscriberCount))</h2>

            #if(subscriberCount > 0):
            <div class="instance-grid">
                #for(subscriber in subscribers):
                <div class="instance-item">
                    <div class="instance-header">
                        <img class="instance-favicon"
                             src="#(subscriber.faviconURL)"
                             alt="" width="16" height="16" loading="lazy"
                             onerror="this.style.display='none'">
                        <a class="instance-domain" href="https://#(subscriber.domain)" target="_blank" rel="noopener">#(subscriber.domain)</a>
                        #if(subscriber.hasBeenChecked):
                            #if(subscriber.isReachable):
                            <span class="status-dot status-ok" title="Online"></span>
                            #else:
                            <span class="status-dot status-down" title="Unreachable"></span>
                            #endif
                        #else:
                            <span class="status-dot status-unknown" title="Checking..."></span>
                        #endif
                    </div>
                    #if(subscriber.softwareName):
                    <div class="instance-meta">
                        <span class="instance-software">#(subscriber.softwareName)#if(subscriber.softwareVersion): #(subscriber.softwareVersion)#endif</span>
                        #if(subscriber.hasRegistrationInfo):
                            #if(subscriber.isOpenRegistrations):
                            <span class="badge badge-sm badge-open">#(t_openRegistrations)</span>
                            #else:
                            <span class="badge badge-sm badge-muted">#(t_closedRegistrations)</span>
                            #endif
                        #endif
                    </div>
                    #endif
                    #if(subscriber.hasStaff):
                    <div class="instance-staff">
                        #for(staff in subscriber.staffAccounts):
                        <a href="#(staff)" class="staff-link" target="_blank" rel="noopener">#(staff)</a>
                        #endfor
                    </div>
                    #endif
                    #if(subscriber.joinedAt):
                    <div class="instance-joined">#(t_joined) #(subscriber.joinedAt)</div>
                    #endif
                </div>
                #endfor
            </div>
            #else:
            <p class="empty-state">#(t_noInstances)</p>
            #endif
        </section>
    </main>

    <footer>
        #if(hasFooter):
        <div class="custom-footer">#unsafeHTML(footer)</div>
        #endif
        <div class="version-info">
            APRelay #(softwareVersion)#if(shortCommit): (#if(sourceURL):<a href="#(sourceURL)">#(shortCommit)</a>#else:#(shortCommit)#endif)#endif
        </div>
    </footer>
</body>
</html>
